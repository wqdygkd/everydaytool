{
  "name": "everydaytool",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@10.6.3",
  "description": "everydaytool (edt) 多功能工具平台 - Electron + Vue 3，首个工具 Chrome沙箱 提供多沙箱浏览器管理",
  "author": "",
  "license": "MIT",
  "keywords": [
    "electron",
    "edt",
    "everydaytool",
    "chrome",
    "sandbox",
    "fingerprint",
    "multi-tool"
  ],
  "main": "dist-electron/electron/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "create:tool": "node scripts/create-tool.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "dev": "concurrently -k \"vite\" \"node scripts/dev-electron.mjs\"",
    "build": "pnpm run build:electron && vite build",
    "start": "electron . --remote-debugging-port=0",
    "postinstall": "electron-builder install-app-deps",
    "pack": "pnpm run build && electron-builder --dir",
    "dist": "pnpm run build && electron-builder"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "element-plus": "^2.9.0",
    "pinia": "^3.0.4",
    "sass": "^1.100.0",
    "vue": "^3.5.13",
    "vue-router": "4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "concurrently": "^9.1.0",
    "electron": "^41.7.0",
    "electron-builder": "^26.11.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.0.14"
  }
}
