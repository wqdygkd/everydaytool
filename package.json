{
  "name": "everydaytool",
  "type": "module",
  "version": "1.1.0",
  "packageManager": "pnpm@10.6.3",
  "description": "everydaytool (edt) 多功能工具平台 - Tauri 2 + Vue 3，内置 7 个工具模块（Chrome 沙箱 / 拦截器等）",
  "author": "",
  "license": "MIT",
  "keywords": [
    "tauri",
    "edt",
    "everydaytool",
    "chrome",
    "sandbox",
    "fingerprint",
    "multi-tool"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "create:tool": "node scripts/create-tool.mjs",
    "web": "vite",
    "dev:web": "vite",
    "dev": "tauri dev",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "prepare:sidecar": "node scripts/prepare-sidecar.mjs",
    "build:web": "vite build",
    "build": "tauri build",
    "dist:installer": "tauri build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "better-sqlite3": "^13.0.3",
    "element-plus": "^2.14.7",
    "gsap": "^3.15.0",
    "node-forge": "^1.4.0",
    "pinia": "^4.1.0",
    "sass": "^1.105.2",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/node-forge": "^1.3.14",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.4"
  }
}
