{
  "name": "everydaytool",
  "type": "module",
  "version": "1.1.0",
  "packageManager": "pnpm@10.6.3",
  "description": "everydaytool (edt) 多功能工具平台 - Electron + Vue 3，内置接口拦截 / 离线包 / Treease 编辑器 / WXP 增强 / 身份证号生成 / 技能管理 / Telegram 缓存（tweb）/ WorkBuddy2API 等工具",
  "author": "",
  "license": "MIT",
  "keywords": [
    "electron",
    "edt",
    "everydaytool",
    "chrome",
    "sandbox",
    "fingerprint",
    "multi-tool"
  ],
  "main": "dist-electron/electron/main.js",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test:skill-manager": "node --experimental-strip-types --test tools/skill-manager/tests/*.test.ts",
    "create:tool": "node scripts/create-tool.mjs",
    "data-layout": "node scripts/data-layout.mjs",
    "data-layers:check": "node scripts/data-layers-check.mjs",
    "tweb:check": "node scripts/build-tweb.mjs --check",
    "tweb:build": "node scripts/build-tweb.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "web": "vite",
    "dev": "concurrently -k \"vite\" \"node scripts/dev-electron.mjs\"",
    "build": "pnpm run build:electron && vite build",
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "pack": "pnpm run build && electron-builder --dir",
    "dist": "pnpm run build && electron-builder"
  },
  "dependencies": {
    "@lucide/vue": "^1.67.0",
    "@radix-icons/vue": "^1.0.0",
    "@tailwindcss/vite": "^4.3.4",
    "@vueuse/core": "^15.0.0",
    "cn": "^0.5.2",
    "gsap": "^3.15.0",
    "node-forge": "^1.4.2",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "sass": "^1.107.1",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-sonner": "^2.0.9",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@types/node": "^26.6.6",
    "@types/node-forge": "^1.3.14",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "concurrently": "^10.0.6",
    "electron": "^44.6.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.14"
  }
}
