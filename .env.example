# MTProto（可选，M3-B）本地凭据示例
# 复制为 .env 后填写；.env 已被 .gitignore 忽略，绝不提交。
#
# 来源：https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# 登录一次后由 `pnpm telegram:session` 生成，粘到这里。
# 该字符串等价于账号登录态，泄露即可被他人使用，请勿提交 / 截图 / 发群。
TELEGRAM_SESSION=

# 可选：teleproto 连接日志级别（0=关闭，1=错误，2=警告，3=信息，4=调试）
TELEGRAM_LOG_LEVEL=1
