{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@shared/*": ["../shared/*"],
      "@ext/*": ["./lib/*"]
    },
    "types": ["chrome", "node"],
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [".", "./.wxt/wxt.d.ts", "../shared/extension.ts", "../shared/interceptor.ts"]
}
