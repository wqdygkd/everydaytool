{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@renderer/*": ["./renderer/*"],
      "@tools/*": ["./tools/*"],
      "@shared/*": ["./shared/*"]
    },
    "resolveJsonModule": true,
    "types": [],
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["auto-imports.d.ts", "components.d.ts", "renderer", "tools/*/index.ts", "tools/**/renderer", "shared", "vite.config.ts"]
}
