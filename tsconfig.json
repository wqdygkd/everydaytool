{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": ["./src/*"],
      "@tools/*": ["./tools/*"],
      "@shared/*": ["./shared/*"]
    },
    "resolveJsonModule": true,
    "types": [],
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["auto-imports.d.ts", "components.d.ts", "src", "tools/*/index.ts", "tools/**/pages", "tools/**/components", "tools/**/stores", "tools/**/composables", "tools/**/shared", "tools/**/tabs.ts", "tools/**/*.test.ts", "tools/**/api.ts", "shared", "vite.config.ts", "vitest.config.ts"]
}
